# --- Secrets and environment ---
.env
.env.*
!.env.example
*.pem
*.key
secrets/

# --- Data (downloaded by loaders, never committed) ---
data/
*.csv
*.parquet
*.zip
*.tar.gz
!tests/**/fixtures/*.csv

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
build/
dist/
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/
.tox/

# --- ML / experiments ---
mlruns/
mlartifacts/
models/*.pkl
models/*.joblib
*.onnx

# --- Node / React ---
node_modules/
frontend/dist/
frontend/build/
frontend/.vite/
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Docker / local volumes ---
pgdata/
docker-volumes/

# --- Kubernetes / deploy (never commit unsealed secrets) ---
kubeconfig
*.kubeconfig
deploy/**/secret.yaml
deploy/**/*-secret.yaml
!deploy/**/sealed-secret*.yaml

# --- Logs and temp ---
*.log
logs/
tmp/
temp/

# --- OS ---
.DS_Store
Thumbs.db
desktop.ini

# --- Editors ---
.vscode/*
!.vscode/extensions.json
!.vscode/settings.example.json
.markdownlint.json
.idea/
*.swp
*~
